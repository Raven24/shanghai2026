---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import avatar from '../content/images/avatar.jpg';

interface Props {
  name?: string;
  bio?: string;
}

const { name = 'Fotoalbum', bio = 'Ein Fotoalbum mit Leidenschaft erstellt.' } = Astro.props;

const sammlungen = await getCollection('sammlungen');
const posts = await getCollection('posts');
---

<section class="profile-header">
  <div class="container">
    <div class="profile-content">
      <div class="profile-avatar">
        <Picture
          src={avatar}
          alt={name}
          formats={['avif', 'webp']}
          widths={[96, 192]}
          sizes="96px"
          loading="lazy"
          class="avatar-image"
        />
      </div>
      
      <div class="profile-info">
        <h1 class="profile-name">{name}</h1>
        <p class="profile-bio">{bio}</p>
        
        <div class="profile-stats">
          <div class="stat">
            <span class="stat-number">{posts.length}</span>
            <span class="stat-label">Posts</span>
          </div>
          <div class="stat">
            <span class="stat-number">{sammlungen.length}</span>
            <span class="stat-label">Collections</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .profile-header {
    padding: var(--spacing-2xl) 0;
    border-bottom: 1px solid var(--color-border);
  }
  
  .profile-content {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-2xl);
  }
  
  .profile-avatar {
    flex-shrink: 0;
  }
  
  .avatar-image {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--color-border);
  }
  
  .profile-info {
    flex: 1;
    min-width: 0;
  }
  
  .profile-name {
    font-size: 2rem;
    margin-bottom: var(--spacing-md);
  }
  
  .profile-bio {
    color: var(--color-subtle-text);
    margin-bottom: var(--spacing-lg);
    line-height: 1.6;
  }
  
  .profile-stats {
    display: flex;
    gap: var(--spacing-xl);
  }
  
  .stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  
  .stat-number {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
  }
  
  .stat-label {
    font-size: 0.85rem;
    color: var(--color-subtle-text);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  
  @media (max-width: 640px) {
    .profile-content {
      flex-direction: column;
      text-align: center;
      gap: var(--spacing-lg);
    }
    
    .profile-avatar {
      margin: 0 auto;
    }
    
    .profile-name {
      font-size: 1.5rem;
    }
    
    .profile-stats {
      justify-content: center;
    }
  }
</style>
