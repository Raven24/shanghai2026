---
import { Picture } from 'astro:assets';

interface ImageItem {
  datei: ImageMetadata;
  alt: string;
}

interface Props {
  bilder: ImageItem[];
  showDots?: boolean;
}

const { bilder, showDots = true } = Astro.props;
const hasMulitple = bilder.length > 1;
---

<div class="carousel-container">
  {hasMulitple ? (
    <>
      <div class="carousel-scroll-wrapper">
        <div class="carousel-scroll">
          {bilder.map((img, idx) => (
            <div class="carousel-item">
              <Picture
                src={img.datei}
                alt={img.alt}
                formats={['avif', 'webp']}
                widths={[480, 768, 1080]}
                sizes="(min-width: 640px) 600px, 100vw"
                loading={idx === 0 ? 'eager' : 'lazy'}
                fetchpriority={idx === 0 ? 'high' : 'auto'}
              />
            </div>
          ))}
        </div>
      </div>
      
      {showDots && (
        <div class="carousel-dots" role="tablist" aria-label="Bildnavigation">
          {bilder.map((_, idx) => (
            <button
              class={`carousel-dot ${idx === 0 ? 'active' : ''}`}
              role="tab"
              aria-selected={idx === 0 ? 'true' : 'false'}
              aria-label={`Bild ${idx + 1} von ${bilder.length}`}
              data-index={idx}
            />
          ))}
        </div>
      )}
    </>
  ) : (
    <div class="carousel-single">
      <Picture
        src={bilder[0].datei}
        alt={bilder[0].alt}
        formats={['avif', 'webp']}
        widths={[480, 768, 1080]}
        sizes="(min-width: 640px) 600px, 100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  )}
</div>

<style>
  .carousel-container {
    width: 100%;
    position: relative;
  }
  
  .carousel-scroll-wrapper {
    width: 100%;
    overflow: hidden;
    border-radius: 8px;
  }
  
  .carousel-scroll {
    display: flex;
    scroll-snap-type: x mandatory;
    overflow-x: auto;
    scroll-behavior: auto;
    /* Disable smooth scroll if user prefers reduced motion */
    @media (prefers-reduced-motion: reduce) {
      scroll-behavior: auto !important;
    }
    /* Scroll snap on first item to prevent initial shift */
    scroll-snap-align: start;
  }
  
  .carousel-item {
    flex: 0 0 100%;
    scroll-snap-align: start;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }
  
  .carousel-item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  
  .carousel-single {
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 8px;
  }
  
  .carousel-single :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  
  .carousel-dots {
    display: flex;
    gap: 8px;
    justify-content: center;
    padding: 12px 0;
    margin-top: 12px;
  }
  
  .carousel-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-border);
    border: none;
    cursor: pointer;
    transition: background-color var(--transition-duration) var(--transition-timing);
    padding: 0;
  }
  
  .carousel-dot:hover {
    background-color: var(--color-subtle-text);
  }
  
  .carousel-dot.active {
    background-color: var(--color-text);
  }
  
  .carousel-dot:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>

<script>
  // Carousel dot indicator synchronization
  const scrollWrapper = document.querySelector('.carousel-scroll') as HTMLElement | null;
  const dots = document.querySelectorAll('.carousel-dot');
  
  if (scrollWrapper && dots.length > 0) {
    function updateActiveDot() {
      const scrollLeft = scrollWrapper!.scrollLeft;
      const itemWidth = scrollWrapper!.firstElementChild?.clientWidth ?? scrollWrapper!.clientWidth;
      const currentIndex = Math.round(scrollLeft / itemWidth);
      
      dots.forEach((dot, idx) => {
        const isActive = idx === currentIndex;
        dot.classList.toggle('active', isActive);
        dot.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });
    }
    
    // Update on scroll
    scrollWrapper.addEventListener('scroll', updateActiveDot, { passive: true });
    
    // Keyboard navigation
    scrollWrapper.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        scrollWrapper!.scrollBy({ left: scrollWrapper!.clientWidth, behavior: 'smooth' });
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        scrollWrapper!.scrollBy({ left: -scrollWrapper!.clientWidth, behavior: 'smooth' });
      }
    });
    
    // Dot click navigation
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const index = parseInt((dot as HTMLElement).dataset.index ?? '0', 10);
        const itemWidth = scrollWrapper!.firstElementChild?.clientWidth ?? scrollWrapper!.clientWidth;
        scrollWrapper!.scrollTo({ left: index * itemWidth, behavior: 'smooth' });
      });
    });
  }
</script>
